{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=YourServer;Initial Catalog=HotelReservationSystem;User ID=YourUserId;Password=YourPassword;Encrypt=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=YourInstrumentationKey",
    "EnableAdaptiveSampling": true,
    "EnablePerformanceCounterCollectionModule": true
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SECRET_KEY_HERE",
    "Issuer": "HotelReservationSystem",
    "Audience": "HotelReservationSystemClients",
    "ExpiryInMinutes": 60
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "SmtpPort": 587,
    "SenderEmail": "notifications@example.com",
    "SenderName": "Hotel Reservation System",
    "Username": "EMAIL_USERNAME",
    "Password": "EMAIL_PASSWORD",
    "EnableSsl": true
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://example.com",
      "https://www.example.com"
    ]
  },
  "FeatureFlags": {
    "EnableNewBookingEngine": false,
    "EnablePaymentProcessing": true
  },
  "Caching": {
    "DistributedCacheEnabled": true,
    "DistributedCacheExpirationMinutes": 30,
    "MemoryCacheExpirationMinutes": 15
  },
  "Authentication": {
    "Facebook": {
      "AppId": "YourFacebookAppId",
      "AppSecret": "YourFacebookAppSecret"
    },
    "Google": {
      "ClientId": "YourGoogleClientId",
      "ClientSecret": "YourGoogleClientSecret"
    },
    "Twitter": {
      "ConsumerKey": "YourTwitterConsumerKey",
      "ConsumerSecret": "YourTwitterConsumerSecret"
    },
    "Microsoft": {
      "ClientId": "YourMicrosoftClientId", 
      "ClientSecret": "YourMicrosoftClientSecret"
    }
  }
}