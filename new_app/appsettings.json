{
  "ConnectionStrings": {
    "DefaultConnection": "Server=#{Database.Server}#;Database=#{Database.Name}#;User Id=#{Database.UserId}#;Password=#{Database.Password}#;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": "#{ApplicationInsights.ConnectionString}#",
    "EnableAdaptiveSampling": true,
    "EnablePerformanceCounterCollectionModule": true,
    "EnableHeartbeat": true
  },
  "JwtSettings": {
    "SecretKey": "#{JWT.SecretKey}#",
    "Issuer": "HotelReservationSystem",
    "Audience": "HotelReservationSystemClients",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryInDays": 7
  },
  "EmailSettings": {
    "SmtpServer": "#{Email.SmtpServer}#",
    "SmtpPort": 587,
    "SenderEmail": "#{Email.SenderEmail}#",
    "SenderName": "Hotel Reservation System",
    "Username": "#{Email.Username}#",
    "Password": "#{Email.Password}#",
    "EnableSsl": true
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://example.com",
      "https://www.example.com"
    ]
  },
  "FeatureFlags": {
    "EnableNewBookingEngine": false,
    "EnablePaymentProcessing": true
  },
  "Caching": {
    "DistributedCacheEnabled": true,
    "DistributedCacheExpirationMinutes": 30,
    "MemoryCacheExpirationMinutes": 15
  },
  "Authentication": {
    "Facebook": {
      "AppId": "YourFacebookAppId",
      "AppSecret": "YourFacebookAppSecret"
    },
    "Google": {
      "ClientId": "YourGoogleClientId",
      "ClientSecret": "YourGoogleClientSecret"
    },
    "Twitter": {
      "ConsumerKey": "YourTwitterConsumerKey",
      "ConsumerSecret": "YourTwitterConsumerSecret"
    },
    "Microsoft": {
      "ClientId": "YourMicrosoftClientId", 
      "ClientSecret": "YourMicrosoftClientSecret"
    }
  },
  "HealthChecks": {
    "Enabled": true,
    "EvaluationTimeInSeconds": 10
  },
  "RateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 10
      },
      {
        "Endpoint": "*/api/booking",
        "Period": "1m",
        "Limit": 30
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    },
    "Certificates": {
      "Default": {
        "Path": "certificate.pfx",
        "Password": "#{Certificate.Password}#"
      }
    }
  }
}
