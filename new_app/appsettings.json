{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost,1433;Initial Catalog=aspnet-HotelReservationSystem;User ID=sa;Password=YourStrongPassword1;Encrypt=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "https://localhost:7001",
    "Audience": "api",
    "IdentityConfiguration": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": true,
      "RequiredLength": 6,
      "RequireConfirmedAccount": false
    },
    "CookieConfiguration": {
      "LoginPath": "/Identity/Account/Login",
      "AccessDeniedPath": "/Identity/Account/AccessDenied",
      "ExpireTimeSpan": "30:00:00:00",
      "SlidingExpiration": true
    },
    "ExternalProviders": {
      "Google": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      },
      "Facebook": {
        "Enabled": false,
        "AppId": "",
        "AppSecret": ""
      }
    },
    "JWT": {
      "SecretKey": "YourSecretKeyHere",
      "Issuer": "HotelReservationSystem",
      "Audience": "HotelReservationSystemApi",
      "ExpiryInMinutes": 30
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=your-instrumentation-key;IngestionEndpoint=https://your-location.in.applicationinsights.azure.com/",
    "EnableAdaptiveSampling": true,
    "EnableQuickPulseMetricStream": true,
    "EnablePerformanceCounterCollectionModule": true,
    "EnableHeartbeat": true
  },
  "Features": {
    "ClientValidationEnabled": true,
    "UnobtrusiveJavaScriptEnabled": true
  }
}