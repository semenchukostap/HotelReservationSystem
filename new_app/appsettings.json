{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DATABASE_SERVER;Database=HotelReservationSystem;User Id=DATABASE_USER;Password=DATABASE_PASSWORD;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": "YOUR_APPLICATION_INSIGHTS_CONNECTION_STRING",
    "EnableAdaptiveSampling": true,
    "EnablePerformanceCounterCollectionModule": true
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SECRET_KEY_HERE",
    "Issuer": "HotelReservationSystem",
    "Audience": "HotelReservationSystemClients",
    "ExpiryInMinutes": 60
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "SmtpPort": 587,
    "SenderEmail": "notifications@example.com",
    "SenderName": "Hotel Reservation System",
    "Username": "EMAIL_USERNAME",
    "Password": "EMAIL_PASSWORD",
    "EnableSsl": true
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://example.com",
      "https://www.example.com"
    ]
  },
  "FeatureFlags": {
    "EnableNewBookingEngine": false,
    "EnablePaymentProcessing": true
  },
  "Caching": {
    "DistributedCacheEnabled": true,
    "DistributedCacheExpirationMinutes": 30,
    "MemoryCacheExpirationMinutes": 15
  }
}