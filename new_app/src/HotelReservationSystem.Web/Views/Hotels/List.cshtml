@model IEnumerable<HotelReservationSystem.Core.DTOs.HotelDto>

@{
    ViewBag.Title = "Hotels";
}

<h2>Hotels</h2>
<p>
    <a asp-action="New" class="btn btn-primary">New Hotel</a>
    <a asp-action="NewCountry" class="btn btn-secondary">New Country</a>
</p>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Hotel</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>Price per night</th>
            <th>All inclusive</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function () {
            var table = $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotels",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name"
                    },
                    {
                        data: "countryName"
                    },
                    {
                        data: "city"
                    },
                    {
                        data: "stars"
                    },
                    {
                        data: "pricePerNight",
                        render: function(data) {
                            return "$" + data.toFixed(2);
                        }
                    },
                    {
                        data: "isAllInclusive",
                        render: function(data) {
                            return data ? "Yes" : "No";
                        }
                    },
                    {
                        data: "id",
                        render: function(data) {
                            return "<a href='/hotels/edit/" + data + "' class='btn btn-primary btn-sm'>Edit</a>";
                        }
                    },
                    {
                        data: "id",
                        render: function(data) {
                            return "<button class='btn btn-danger btn-sm js-delete' data-hotel-id='" + data + "'>Delete</button>";
                        }
                    }
                ]
            });

            $("#hotels").on("click", ".js-delete", function () {
                var button = $(this);
                bootbox.confirm({
                    message: "Are you sure you want to delete this hotel?",
                    buttons: {
                        confirm: {
                            label: 'Yes',
                            className: 'btn-danger'
                        },
                        cancel: {
                            label: 'No',
                            className: 'btn-secondary'
                        }
                    },
                    callback: function (result) {
                        if (result) {
                            $.ajax({
                                url: "/api/hotels/" + button.attr("data-hotel-id"),
                                method: "DELETE",
                                success: function () {
                                    table.row(button.parents("tr")).remove().draw();
                                    toastr.success("Hotel has been deleted.");
                                },
                                error: function () {
                                    toastr.error("Something went wrong! The hotel could not be deleted.");
                                }
                            });
                        }
                    }
                });
            });
        });
    </script>
}