{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=[PRODUCTION-SERVER];Initial Catalog=HotelReservationSystem_Prod;User ID=[PROD-USER];Password=[PROD-PASSWORD];Encrypt=True;TrustServerCertificate=False"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "ApplicationInsights": {
    "EnableAdaptiveSampling": true,
    "EnableQuickPulseMetricStream": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001",
        "Certificate": {
          "Path": "certificate.pfx",
          "Password": "[CERT-PASSWORD]"
        }
      }
    }
  }
}