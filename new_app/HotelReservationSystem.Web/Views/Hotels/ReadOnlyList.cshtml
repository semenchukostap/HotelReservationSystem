@model IEnumerable<HotelReservationSystem.Core.DTOs.HotelDto>

@{
    ViewData["Title"] = "Hotels";
}

<h3 class="page-header">Hotels</h3>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>Price</th>
            <th>All Inclusive</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotels",
                    dataSrc: ""
                },
                columns: [
                    { data: "name" },
                    { data: "countryName" },
                    { data: "city" },
                    { data: "stars" },
                    { 
                        data: "pricePerNight",
                        render: function (data) {
                            return "$" + parseFloat(data).toFixed(2);
                        } 
                    },
                    { 
                        data: "isAllInclusive",
                        render: function (data) {
                            return data ? "Yes" : "No";
                        }
                    }
                ]
            });
        });
    </script>
}