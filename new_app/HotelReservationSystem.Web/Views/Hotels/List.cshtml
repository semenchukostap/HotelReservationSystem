@model IEnumerable<HotelReservationSystem.Core.DTOs.HotelDto>

@{
    ViewData["Title"] = "Hotels Management";
}

<h3 class="page-header">Hotels</h3>

<p>
    <a asp-action="New" class="btn btn-primary">Add New</a>
</p>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>Price</th>
            <th>All Inclusive</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotels",
                    dataSrc: ""
                },
                columns: [
                    { data: "name" },
                    { data: "countryName" },
                    { data: "city" },
                    { data: "stars" },
                    { 
                        data: "pricePerNight",
                        render: function (data) {
                            return "$" + parseFloat(data).toFixed(2);
                        } 
                    },
                    { 
                        data: "isAllInclusive",
                        render: function (data) {
                            return data ? "Yes" : "No";
                        }
                    },
                    {
                        data: "id",
                        render: function (data) {
                            return `
                                <a href="/Hotels/Edit/${data}" class="btn btn-sm btn-primary">Edit</a>
                                <button class="btn btn-sm btn-danger js-delete" data-hotel-id="${data}">Delete</button>
                            `;
                        }
                    }
                ]
            });
            
            $("#hotels").on("click", ".js-delete", function () {
                var button = $(this);
                
                bootbox.confirm({
                    title: "Delete Hotel",
                    message: "Are you sure you want to delete this hotel?",
                    buttons: {
                        cancel: {
                            label: '<i class="fa fa-times"></i> Cancel'
                        },
                        confirm: {
                            label: '<i class="fa fa-check"></i> Confirm'
                        }
                    },
                    callback: function (result) {
                        if (result) {
                            $.ajax({
                                url: "/api/hotels/" + button.attr("data-hotel-id"),
                                method: "DELETE",
                                success: function () {
                                    table.row(button.parents("tr")).remove().draw();
                                    toastr.success("Hotel has been deleted successfully!");
                                },
                                error: function () {
                                    toastr.error("Something went wrong!");
                                }
                            });
                        }
                    }
                });
            });
        });
    </script>
}