@model HotelReservationSystem.Web.ViewModels.HotelViewModel

@{
    ViewData["Title"] = Model.Hotel.Id == 0 ? "New Hotel" : "Edit Hotel";
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Save" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Hotel.Id" />
            
            <div class="form-group mb-3">
                <label asp-for="Hotel.Name" class="form-label"></label>
                <input asp-for="Hotel.Name" class="form-control" />
                <span asp-validation-for="Hotel.Name" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Hotel.CountryId" class="form-label">Country</label>
                <div class="d-flex">
                    <select asp-for="Hotel.CountryId" asp-items="@(new SelectList(Model.Countries, "Id", "Name"))" class="form-select me-2">
                        <option value="">Select Country</option>
                    </select>
                    <a asp-action="NewCountry" class="btn btn-outline-secondary">New Country</a>
                </div>
                <span asp-validation-for="Hotel.CountryId" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Hotel.City" class="form-label"></label>
                <input asp-for="Hotel.City" class="form-control" />
                <span asp-validation-for="Hotel.City" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Hotel.Stars" class="form-label"></label>
                <input asp-for="Hotel.Stars" class="form-control" min="1" max="5" />
                <span asp-validation-for="Hotel.Stars" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Hotel.PricePerNight" class="form-label"></label>
                <input asp-for="Hotel.PricePerNight" class="form-control" step="0.01" />
                <span asp-validation-for="Hotel.PricePerNight" class="text-danger"></span>
            </div>
            
            <div class="form-check mb-3">
                <input asp-for="Hotel.IsAllInclusive" class="form-check-input" />
                <label asp-for="Hotel.IsAllInclusive" class="form-check-label">All Inclusive</label>
            </div>
            
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}