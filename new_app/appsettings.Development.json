{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft": "Information",
        "Microsoft.AspNetCore.SpaProxy": "Information",
        "Microsoft.EntityFrameworkCore": "Debug"
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Debug"
      },
      "EnableSensitiveDataLogging": true,
      "EnableHeartbeat": true,
      "EnableDependencyTrackingTelemetryModule": true,
      "EnableAzureInstanceMetadataTelemetryModule": true,
      "EnableDebugMode": true,
      "EnableW3CDistributedTracing": true,
      "EnablePerformanceCounters": true
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HotelReservationSystem;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "DetailedErrors": true,
  "Authentication": {
    "Facebook": {
      "AppId": "YOUR_FACEBOOK_APP_ID",
      "AppSecret": "YOUR_FACEBOOK_APP_SECRET"
    }
  },
  "AllowedHosts": "*",
  "IdentityServer": {
    "Key": {
      "Type": "Development"
    }
  },
  "FeatureManagement": {
    "EnableDiagnostics": true,
    "EnableDetailedErrors": true,
    "EnableInMemoryDatabase": true
  }
}
