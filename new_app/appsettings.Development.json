{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft": "Information",
      "System": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Debug",
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "DetailedErrors": true,
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DevDatabase;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "AllowedHosts": "localhost",
  "DeveloperMode": true,
  "FeatureFlags": {
    "EnableBetaFeatures": true,
    "ShowDebugInformation": true
  },
  "CorsOrigins": [
    "http://localhost:3000",
    "http://localhost:8080"
  ]
}