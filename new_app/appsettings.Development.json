{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.EntityFrameworkCore": "Debug",
      "System": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Trace",
        "Microsoft.AspNetCore": "Debug"
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "Trace",
        "Microsoft.AspNetCore": "Trace"
      }
    }
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "FeatureManagement": {
    "EnableDiagnostics": true,
    "EnableSwagger": true,
    "EnableDeveloperExceptions": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DevDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    },
    "Development": {
      "HttpsPort": 5001,
      "HttpPort": 5000
    }
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:4200", "http://localhost:4200", "https://localhost:3000", "http://localhost:3000"]
  },
  "DevelopmentSettings": {
    "EnableInMemoryDatabase": false,
    "DisableHttpsRedirection": true,
    "UseInMemoryIdentityProvider": true,
    "SeedTestData": true,
    "AutoMigrate": true,
    "MockExternalServices": true
  },
  "IdentityServer": {
    "Key": {
      "Type": "Development"
    }
  },
  "ApiOptions": {
    "CacheTimeout": 30,
    "EnableRateLimiting": false,
    "BypassAuthentication": true
  }
}