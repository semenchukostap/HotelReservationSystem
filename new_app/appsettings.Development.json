{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft": "Debug",
      "System": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Trace",
        "Microsoft.AspNetCore": "Debug"
      },
      "FormatterOptions": {
        "SingleLine": false,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": false,
        "JsonWriterOptions": {
          "Indented": true
        }
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "Trace"
      }
    },
    "EventSource": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DevDatabase;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "TestConnection": "Server=localhost;Database=TestDatabase;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "DeveloperMode": true,
  "Development": {
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": true,
    "EnableDeveloperExceptions": true,
    "UseMockServices": true
  },
  "PerformanceOptions": {
    "EnableCompression": false,
    "EnableCaching": false,
    "EnableMinification": false,
    "EnableBundling": false
  },
  "FeatureFlags": {
    "EnableBetaFeatures": true,
    "ShowDebugInformation": true,
    "EnableExperimentalApi": true,
    "EnableInMemoryDatabase": true,
    "UseLocalServices": true
  },
  "CorsOrigins": [
    "http://localhost:3000",
    "http://localhost:8080",
    "http://localhost:4200"
  ],
  "Authentication": {
    "DisableAuthentication": true
  },
  "EmailSettings": {
    "UseFakeEmailSender": true,
    "FakeEmailOutputDirectory": "./emails",
    "RedirectAllEmailsTo": "developer@example.com"
  },
  "Diagnostics": {
    "EnableHealthChecks": true,
    "EnableMetrics": true,
    "EnableRequestLogging": true,
    "EnablePerformanceCounters": true
  },
  "Swagger": {
    "Enabled": true,
    "ShowTryItOut": true,
    "EnableAuthentication": false
  }
}
