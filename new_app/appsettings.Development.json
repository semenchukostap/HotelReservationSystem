{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost,1433;Initial Catalog=aspnet-HotelReservationSystem-Dev;User ID=sa;Password=YourStrongPassword1;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.Hosting.Lifetime": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore": "Debug",
      "System": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Trace",
        "Microsoft": "Debug"
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "Trace",
        "Microsoft": "Debug"
      }
    },
    "File": {
      "Path": "App_Data/Logs/dev-log-.txt",
      "Append": true,
      "FileSizeLimitBytes": 10485760,
      "MaxRollingFiles": 10
    }
  },
  "DetailedErrors": true,
  "Authentication": {
    "RequireConfirmedEmail": false,
    "RequireConfirmedAccount": false,
    "AllowLocalLogin": true,
    "SecurityStampValidationInterval": 600,
    "CookieExpiration": 1440,
    "UseDevCredentials": true,
    "DevAdminCredentials": {
      "UserName": "admin@example.com",
      "Password": "DevPassword123!"
    }
  },
  "FeatureManagement": {
    "BetaFeatures": true,
    "DebugTools": true
  },
  "AllowedHosts": "*",
  "IdentityServer": {
    "Key": {
      "Type": "Development"
    }
  },
  "MailSettings": {
    "UseDevelopmentSettings": true,
    "MailFolder": "App_Data/DevEmails"
  },
  "CorsPolicy": {
    "AllowAnyOrigin": true
  },
  "StaticFiles": {
    "CacheControl": "no-cache, no-store"
  },
  "Development": {
    "SeedDatabaseWithTestData": true,
    "ShowSwagger": true,
    "EnableDetailedExceptions": true,
    "UseInMemoryDatabase": false,
    "AutoMigrate": true,
    "DisableHttpsRedirection": true,
    "UseDeveloperExceptionPage": true,
    "ShowSensitiveData": true,
    "MockExternalServices": true,
    "HotReload": {
      "Enabled": true,
      "PollIntervalSeconds": 2
    },
    "PerformanceMonitoring": {
      "Enabled": true,
      "MinimumDuration": 100,
      "TrackQueries": true
    }
  },
  "EmailSettings": {
    "UseMailhogForDevelopment": true,
    "MailhogServer": "localhost",
    "MailhogPort": 1025
  }
}
