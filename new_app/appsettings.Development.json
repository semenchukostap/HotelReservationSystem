{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost,1433;Initial Catalog=aspnet-HotelReservationSystem-Dev;User ID=sa;Password=YourStrongPassword1;Encrypt=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore": "Debug",
      "System": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Debug",
        "Microsoft": "Debug"
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft": "Debug"
      }
    }
  },
  "DetailedErrors": true,
  "Authentication": {
    "RequireConfirmedEmail": false,
    "RequireConfirmedAccount": false,
    "AllowLocalLogin": true
  },
  "FeatureManagement": {
    "BetaFeatures": true,
    "DebugTools": true
  },
  "AllowedHosts": "*",
  "IdentityServer": {
    "Key": {
      "Type": "Development"
    }
  },
  "MailSettings": {
    "UseDevelopmentSettings": true,
    "MailFolder": "App_Data/DevEmails"
  },
  "CorsPolicy": {
    "AllowAnyOrigin": true
  },
  "StaticFiles": {
    "CacheControl": "no-cache, no-store"
  },
  "Development": {
    "SeedDatabaseWithTestData": true,
    "ShowSwagger": true,
    "EnableDetailedExceptions": true,
    "UseInMemoryDatabase": false
  }
}