{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "System": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true
      },
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft.AspNetCore": "Debug"
      }
    }
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "FeatureManagement": {
    "EnableDiagnostics": true,
    "EnableSwagger": true,
    "EnableDeveloperExceptions": true,
    "EnableHotReload": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DevDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2AndHttp3"
    },
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5001"
      },
      "Http": {
        "Url": "http://localhost:5000"
      }
    },
    "Certificates": {
      "Development": {
        "Password": "DevCertPassword"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:4200", "http://localhost:4200", "https://localhost:3000", "http://localhost:3000"],
    "AllowCredentials": true,
    "ExposedHeaders": ["X-Pagination", "X-Request-Id"]
  },
  "DevelopmentSettings": {
    "EnableInMemoryDatabase": false,
    "DisableHttpsRedirection": true,
    "UseInMemoryIdentityProvider": true,
    "SeedTestData": true,
    "AutoMigrate": true,
    "MockExternalServices": true,
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  },
  "IdentityServer": {
    "Key": {
      "Type": "Development"
    },
    "DeveloperSigningCredential": true
  },
  "ApiOptions": {
    "CacheTimeout": 0,
    "EnableRateLimiting": false,
    "BypassAuthentication": true,
    "EnableRequestResponseLogging": true
  },
  "HealthChecks": {
    "Enabled": true,
    "EvaluationTimeInSeconds": 10
  },
  "OpenApi": {
    "EnableSwagger": true,
    "EnableSwaggerUI": true,
    "EnableVersioning": true
  }
}
