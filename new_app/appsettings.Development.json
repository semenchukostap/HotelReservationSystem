{
  "Environment": "Development",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft": "Debug",
      "System": "Debug",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Trace",
        "Microsoft.AspNetCore": "Debug"
      },
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "UseUtcTimestamp": false,
        "JsonWriterOptions": {
          "Indented": true
        }
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "Trace",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      },
      "IncludeScopes": true
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Debug"
      },
      "EnableSensitiveDataLogging": true,
      "EnableHeartbeat": true,
      "EnableDependencyTrackingTelemetryModule": true,
      "EnableAzureInstanceMetadataTelemetryModule": true,
      "EnableDebugMode": true,
      "EnableW3CDistributedTracing": true,
      "EnablePerformanceCounters": true
    },
    "EventSource": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "File": {
      "BasePath": "Logs",
      "FileEncodingName": "utf-8",
      "DateFormat": "yyyyMMdd",
      "CounterFormat": "000",
      "MaxFileSize": 10485760,
      "IncludeScopes": true,
      "RollingInterval": "Day",
      "LogLevel": {
        "Default": "Trace"
      }
    },
    "Development": {
      "LogToConsole": true,
      "LogToFile": true,
      "CaptureDiagnosticEvents": true,
      "LogQueryParameters": true,
      "EnableSensitiveDataLogging": true,
      "EnableStructuredLogging": true,
      "DetailedExceptions": true,
      "LogPerformanceMetrics": true,
      "TraceCookiesAndHeaders": true,
      "EnableDeveloperLogs": true
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DevDatabase;User Id=devuser;Password=devpassword;MultipleActiveResultSets=true;TrustServerCertificate=true",
    "ReadOnlyConnection": "Server=localhost;Database=DevDatabase;User Id=readonly;Password=readonlypass;ApplicationIntent=ReadOnly;MultipleActiveResultSets=true;TrustServerCertificate=true",
    "Redis": "localhost:6379",
    "AzureStorage": "UseDevelopmentStorage=true"
  },
  "IdentityServer": {
    "Key": {
      "Type": "Development",
      "FilePath": "dev-signing-key.pfx",
      "Password": "devpassword"
    },
    "BehaviorOptions": {
      "RequirePkce": true,
      "RequireClientSecret": false
    },
    "Clients": [
      {
        "ClientId": "dev-spa-client",
        "AllowedGrantTypes": ["authorization_code"],
        "RequireClientSecret": false,
        "RedirectUris": ["http://localhost:3000/callback", "http://localhost:4200/callback"],
        "PostLogoutRedirectUris": ["http://localhost:3000", "http://localhost:4200"],
        "AllowedCorsOrigins": ["http://localhost:3000", "http://localhost:4200"],
        "AllowedScopes": ["openid", "profile", "api"]
      }
    ]
  },
  "Email": {
    "SmtpServer": "localhost",
    "SmtpPort": 25,
    "UseSSL": false,
    "SenderName": "Dev App",
    "SenderEmail": "dev@example.com",
    "Username": "devuser",
    "Password": "devpassword",
    "Development": {
      "WriteEmailsToFile": true,
      "EmailFileDirectory": "C:/temp/dev-emails",
      "RedirectAllEmailsTo": "developer@example.com",
      "DisplayInBrowserWindow": true,
      "CaptureEmailContent": true,
      "SaveAttachments": true
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=00000000-0000-0000-0000-000000000000",
    "EnableAdaptiveSampling": false,
    "EnableDependencyTracking": true,
    "EnablePerformanceCounterCollectionModule": true,
    "EnableDebugLogger": true,
    "DeveloperMode": true,
    "EnableLiveMetrics": true,
    "EnableRequestTrackingTelemetryModule": true,
    "EnableHeartbeat": true,
    "DeveloperSettings": {
      "EnableDebugView": true,
      "LocalForwarderEnabled": true,
      "ProfileQueryPlan": true,
      "SnapshotDebugger": true,
      "DetailedTelemetry": true,
      "CollectMemoryUsage": true
    }
  },
  "DetailedErrors": true,
  "CORS": {
    "Origins": ["http://localhost:3000", "http://localhost:4200", "http://localhost:8080"],
    "AllowCredentials": true,
    "AllowAnyMethod": true,
    "AllowAnyHeader": true
  },
  "ApiKeys": {
    "ExternalService1": "dev-api-key-1",
    "ExternalService2": "dev-api-key-2"
  },
  "Features": {
    "EnableBetaFeatures": true,
    "EnableSwagger": true,
    "EnableDevTools": true,
    "EnableDevEndpoints": true,
    "ShowDebugViews": true,
    "EnableFeatureToggles": true
  },
  "Development": {
    "ShowStackTrace": true,
    "EnableMiniProfiler": true,
    "EnableInMemoryCache": true,
    "DisableHttpsRedirection": true,
    "UseSpaDevServer": true,
    "AutoMigrateDatabase": true,
    "SeedTestData": true,
    "DisableAuthentication": false,
    "MockExternalServices": true,
    "SimulateLatency": {
      "Enabled": false,
      "MinLatencyMs": 100,
      "MaxLatencyMs": 500
    },
    "ShowDebugInformation": true,
    "StaticFiles": {
      "EnableDirectoryBrowsing": true,
      "CacheControl": "no-cache"
    },
    "ExceptionHandling": {
      "ShowDetailedErrors": true,
      "LogAllExceptions": true,
      "CaptureStartupErrors": true,
      "IncludeExceptionDetails": true,
      "CollectFullStackTrace": true,
      "TrackExceptionChain": true
    },
    "HealthChecks": {
      "Enabled": true,
      "DetailedOutput": true,
      "IntervalSeconds": 30,
      "EvaluationTimeInSeconds": 10,
      "VerboseLogging": true,
      "SaveToFile": true
    },
    "Diagnostics": {
      "EnableDiagnosticsPage": true,
      "CollectMemorySnapshots": true,
      "EnableResponseCompression": false,
      "LogHeadersAndCookies": true,
      "EnableRuntimeInfoPage": true,
      "EnableRequestTracing": true,
      "EnablePerformanceMonitoring": true,
      "LogHttpRequests": true,
      "LogApiCallDurations": true,
      "TrackThreadUsage": true
    },
    "Security": {
      "AllowWeakPasswords": true,
      "DisableCsrf": false,
      "AllowLocalAuthentication": true,
      "DisableRateLimiting": true,
      "ShowSecurityHeaders": true
    },
    "Database": {
      "EnableSensitiveDataLogging": true,
      "CommandTimeout": 300,
      "EnableDetailedErrors": true,
      "UseBatchProcessing": false,
      "LogSlowQueries": true,
      "SlowQueryThresholdMs": 500,
      "ShowQueryPlans": true
    },
    "PerformanceProfiling": {
      "Enabled": true,
      "CollectMethodTimings": true,
      "ShowSlowestOperations": true,
      "LogMemoryUsage": true,
      "MemorySnapshotInterval": 60
    },
    "HotReload": {
      "Enabled": true,
      "WatchFolders": ["Views", "wwwroot", "Areas"]
    }
  }
}
