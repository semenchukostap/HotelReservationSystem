{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft": "Information",
      "System": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Debug",
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DevDatabase;User Id=devuser;Password=devpassword;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "IdentityServer": {
    "Key": {
      "Type": "Development"
    },
    "BehaviorOptions": {
      "RequirePkce": true
    }
  },
  "Email": {
    "SmtpServer": "localhost",
    "SmtpPort": 25,
    "UseSSL": false,
    "SenderName": "Dev App",
    "SenderEmail": "dev@example.com",
    "Username": "devuser",
    "Password": "devpassword"
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "EnableAdaptiveSampling": false,
    "EnableDependencyTracking": true,
    "EnablePerformanceCounterCollectionModule": true
  },
  "DetailedErrors": true,
  "CORS": {
    "Origins": ["http://localhost:3000", "http://localhost:4200", "http://localhost:8080"]
  },
  "ApiKeys": {
    "ExternalService1": "dev-api-key-1",
    "ExternalService2": "dev-api-key-2"
  },
  "Features": {
    "EnableBetaFeatures": true,
    "EnableSwagger": true
  }
}