@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form id="logoutForm" class="navbar-right" asp-controller="Account" asp-action="LogOut" method="post">
        @Html.AntiForgeryToken()
        <ul class="nav navbar-nav navbar-right">
            <li>
                <a id="manage" asp-controller="Manage" asp-action="Index" title="Manage">Hello @User.Identity.Name!</a>
            </li>
            <li>
                <a href="javascript:document.getElementById('logoutForm').submit()" id="logoutLink">Logout</a>
            </li>
        </ul>
    </form>
}
else
{
    <ul class="nav navbar-nav navbar-right">
        <li>
            <a id="registerLink" asp-controller="Account" asp-action="Register">Register</a>
        </li>
        <li>
            <a id="loginLink" asp-controller="Account" asp-action="Login">Login</a>
        </li>
    </ul>
}
