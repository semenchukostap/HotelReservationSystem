@model IEnumerable<Hotel>
@{
    ViewData["Title"] = "Hotels";
}

<h2>Hotels</h2>
<p>
    <a asp-action="New" class="btn btn-primary">New Hotel</a>
</p>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Hotel</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>All-inclusive</th>
            <th>Price</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

@section Scripts 
{
    <script>
        $(document).ready(function () {
            var table = $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotels",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name"
                    },
                    {
                        data: "country.name"
                    },
                    {
                        data: "city"
                    },
                    {
                        data: "stars"
                    },
                    {
                        data: "isAllInclusive",
                        render: function (data) {
                            return data ? "Yes" : "No";
                        }
                    },
                    {
                        data: "pricePerNight",
                        render: function (data) {
                            return "$" + data;
                        }
                    },
                    {
                        data: "id",
                        render: function (data) {
                            return `<a href='/Hotels/Edit/${data}' class='btn btn-sm btn-warning'>Edit</a> 
                                   <button class='btn btn-sm btn-danger js-delete' data-hotel-id='${data}'>Delete</button>`;
                        }
                    }
                ]
            });

            $("#hotels").on("click", ".js-delete", function () {
                const button = $(this);
                bootbox.confirm({
                    message: "Are you sure you want to delete this hotel?",
                    buttons: {
                        confirm: {
                            label: 'Yes',
                            className: 'btn-danger'
                        },
                        cancel: {
                            label: 'No',
                            className: 'btn-secondary'
                        }
                    },
                    callback: function (result) {
                        if (result) {
                            $.ajax({
                                url: `/api/hotels/${button.attr("data-hotel-id")}`,
                                method: "DELETE",
                                success: function () {
                                    table.row(button.parents("tr")).remove().draw();
                                    toastr.success("Hotel successfully deleted");
                                },
                                error: function () {
                                    toastr.error("Something went wrong!");
                                }
                            });
                        }
                    }
                });
            });
        });
    </script>
}