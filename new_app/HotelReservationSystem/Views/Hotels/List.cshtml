@model IEnumerable<Hotel>
@{
    ViewData["Title"] = "Hotels";
}

<h2 class="mb-4">Hotels</h2>
<p>
    <a asp-controller="Hotels" asp-action="New" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New Hotel
    </a>
</p>

<table id="hotels" class="table table-striped table-bordered table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Hotel</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>All-inclusive</th>
            <th>Price</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

@section Scripts 
{
    <script>
        $(document).ready(function () {
            var table = $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotels",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name"
                    },
                    {
                        data: "country.name"
                    },
                    {
                        data: "city"
                    },
                    {
                        data: "stars",
                        render: function(data) {
                            let stars = '';
                            for (let i = 0; i < data; i++) {
                                stars += '<i class="bi bi-star-fill text-warning"></i>';
                            }
                            return stars;
                        }
                    },
                    {
                        data: "isAllInclusive",
                        render: function (data) {
                            return data ? 
                                '<span class="badge bg-success"><i class="bi bi-check-circle"></i> Yes</span>' : 
                                '<span class="badge bg-secondary"><i class="bi bi-x-circle"></i> No</span>';
                        }
                    },
                    {
                        data: "pricePerNight",
                        render: function (data) {
                            return `<span class="fw-bold">$${data.toFixed(2)}</span>`;
                        }
                    },
                    {
                        data: "id",
                        render: function (data) {
                            return `
                                <div class="btn-group" role="group">
                                    <a asp-controller="Hotels" asp-action="Edit" asp-route-id="${data}" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <button class='btn btn-sm btn-danger js-delete' data-hotel-id='${data}'>
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>`;
                        }
                    }
                ],
                responsive: true,
                language: {
                    emptyTable: "No hotels available"
                }
            });

            $("#hotels").on("click", ".js-delete", function () {
                const button = $(this);
                bootbox.confirm({
                    title: "<i class='bi bi-exclamation-triangle-fill text-danger'></i> Confirm Deletion",
                    message: "<p class='text-center'>Are you sure you want to delete this hotel?</p><p class='text-center text-muted small'>This action cannot be undone.</p>",
                    buttons: {
                        confirm: {
                            label: '<i class="bi bi-trash"></i> Yes, Delete',
                            className: 'btn-danger'
                        },
                        cancel: {
                            label: '<i class="bi bi-x"></i> Cancel',
                            className: 'btn-outline-secondary'
                        }
                    },
                    backdrop: true,
                    callback: function (result) {
                        if (result) {
                            $.ajax({
                                url: `/api/hotels/${button.attr("data-hotel-id")}`,
                                method: "DELETE",
                                success: function () {
                                    table.row(button.parents("tr")).remove().draw();
                                    toastr.success("Hotel successfully deleted", "Success");
                                },
                                error: function (xhr) {
                                    const errorMsg = xhr.responseJSON?.message || "Something went wrong!";
                                    toastr.error(errorMsg, "Error");
                                }
                            });
                        }
                    }
                });
            });
        });
    </script>
}
