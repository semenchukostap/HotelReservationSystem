@model HotelViewModel

@{
    ViewBag.Title = Model.Hotel.Id == 0 ? "New Hotel" : "Edit Hotel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>

<form asp-controller="Hotels" asp-action="Save" method="post">
    <div class="mb-3">
        <label asp-for="Hotel.Name" class="form-label"></label>
        <input asp-for="Hotel.Name" class="form-control" />
        <span asp-validation-for="Hotel.Name" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Hotel.CountryId" class="form-label">Country</label>
        <select asp-for="Hotel.CountryId" asp-items="@(new SelectList(Model.Countries, "Id", "Name"))" class="form-select">
            <option value="">Select Country</option>
        </select>
        <span asp-validation-for="Hotel.CountryId" class="text-danger"></span>
        <div class="mt-1">
            <a asp-controller="Hotels" asp-action="NewCountry" class="btn btn-link p-0">Add New Country</a>
        </div>
    </div>
    
    <div class="mb-3">
        <label asp-for="Hotel.City" class="form-label"></label>
        <input asp-for="Hotel.City" class="form-control" />
        <span asp-validation-for="Hotel.City" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Hotel.Stars" class="form-label"></label>
        <input asp-for="Hotel.Stars" class="form-control" type="number" min="1" max="5" />
        <span asp-validation-for="Hotel.Stars" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Hotel.PricePerNight" class="form-label"></label>
        <input asp-for="Hotel.PricePerNight" class="form-control" type="number" min="1" step="0.01" />
        <span asp-validation-for="Hotel.PricePerNight" class="text-danger"></span>
    </div>
    
    <div class="mb-3 form-check">
        <input asp-for="Hotel.IsAllInclusive" type="checkbox" class="form-check-input" />
        <label asp-for="Hotel.IsAllInclusive" class="form-check-label"></label>
    </div>
    
    <input type="hidden" asp-for="Hotel.Id" />
    @Html.AntiForgeryToken()
    
    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}