@{
    ViewData["Title"] = "About";
}

<div class="container">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>About Hotel Reservation System</h2>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h3>Overview</h3>
                    <p class="lead">
                        Our Hotel Reservation System allows you to efficiently manage hotels, customers, and reservations
                        with a modern user interface built on Bootstrap 5 and ASP.NET Core MVC.
                    </p>
                    <p>
                        This application has been migrated from .NET Framework 4.5.2 and ASP.NET MVC 5 to 
                        .NET 8 and ASP.NET Core MVC, incorporating modern web development practices while
                        maintaining the core functionality of the original application.
                    </p>
                </div>
                <div class="col-md-6">
                    <div class="alert alert-info">
                        <h4>Technical Details</h4>
                        <ul class="list-group list-group-flush mt-3">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Framework
                                <span class="badge bg-primary rounded-pill">.NET 8</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Web Framework
                                <span class="badge bg-success rounded-pill">ASP.NET Core MVC</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                UI Framework
                                <span class="badge bg-info rounded-pill">Bootstrap 5.3.2</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Database Access
                                <span class="badge bg-warning rounded-pill">Entity Framework Core</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Authentication
                                <span class="badge bg-secondary rounded-pill">ASP.NET Core Identity</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <h3>Features</h3>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">Hotel Management</h5>
                                    <p class="card-text">Create, read, update, and delete hotel information including details like name, address, and pricing.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">Customer Management</h5>
                                    <p class="card-text">Maintain customer information, track customer history, and manage customer relationships.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">Reservation System</h5>
                                    <p class="card-text">Create and manage bookings, handle reservation changes, and track booking statuses.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house-fill me-1"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</div>