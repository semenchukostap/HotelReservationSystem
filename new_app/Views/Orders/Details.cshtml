@model HotelReservationSystem.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<h2 class="mb-4">Order Details</h2>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Order #@Model?.Id</h4>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Customer Information</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Name:</dt>
                            <dd class="col-sm-8">@Model?.Customer?.Name</dd>
                            
                            @if (Model?.Customer?.Birthdate.HasValue == true)
                            {
                                <dt class="col-sm-4">Birthdate:</dt>
                                <dd class="col-sm-8">@Model.Customer.Birthdate?.ToString("yyyy-MM-dd")</dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Hotel Information</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Name:</dt>
                            <dd class="col-sm-8">@Model?.Hotel?.Name</dd>
                            
                            <dt class="col-sm-4">Location:</dt>
                            <dd class="col-sm-8">@Model?.Hotel?.City, @Model?.Hotel?.Country?.Name</dd>
                            
                            <dt class="col-sm-4">Stars:</dt>
                            <dd class="col-sm-8">
                                @for (int i = 0; i < (Model?.Hotel?.Stars ?? 0); i++)
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                            </dd>
                            
                            <dt class="col-sm-4">Price per night:</dt>
                            <dd class="col-sm-8">$@(Model?.Hotel?.PricePerNight.ToString("F2") ?? "0.00")</dd>
                            
                            <dt class="col-sm-4">All Inclusive:</dt>
                            <dd class="col-sm-8">@(Model?.Hotel?.IsAllInclusive == true ? "Yes" : "No")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card mt-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Booking Details</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Order Date:</dt>
                    <dd class="col-sm-9">@Model?.DateOrdered.ToString("yyyy-MM-dd HH:mm")</dd>
                    
                    <dt class="col-sm-3">Stay Period:</dt>
                    <dd class="col-sm-9">@Model?.StartDate.ToString("yyyy-MM-dd") to @Model?.EndDate.ToString("yyyy-MM-dd") (@Model?.NumberOfDays days)</dd>
                    
                    <dt class="col-sm-3">Total Price:</dt>
                    <dd class="col-sm-9">$@Model?.FullPrice.ToString("F2")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex gap-2">
        <a asp-controller="Orders" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
        <a asp-controller="Orders" asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Any JavaScript needed for this view
        });
    </script>
}
