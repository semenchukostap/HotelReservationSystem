@{
    ViewData["Title"] = "Orders";
}

<h3 class="display-4 mb-4">Orders</h3>

<div>
    <a asp-controller="Orders" asp-action="New" class="btn btn-primary mb-3">
        <i class="bi bi-plus-circle"></i> New Order
    </a>
</div>

<div class="table-responsive">
    <table id="orders" class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Customer</th>
                <th>Hotel</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Full Price</th>
                <th>Date Ordered</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const ordersTable = new DataTable('#orders', {
                ajax: {
                    url: "/api/NewOrders",
                    dataSrc: ""
                },
                columns: [
                    { 
                        data: "customer.name" 
                    },
                    { 
                        data: "hotel.name" 
                    },
                    {
                        data: "startDate",
                        render: data => new Date(data).toLocaleDateString()
                    },
                    {
                        data: "endDate",
                        render: data => new Date(data).toLocaleDateString()
                    },
                    {
                        data: "fullPrice",
                        render: data => `$${data.toFixed(2)}`
                    },
                    {
                        data: "dateOrdered",
                        render: data => new Date(data).toLocaleDateString()
                    },
                    {
                        data: "id",
                        render: data => `
                            <div class="d-flex gap-2">
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="${data}" class="btn btn-sm btn-info">
                                    <i class="bi bi-info-circle"></i> Details
                                </a>
                                <button class="btn btn-sm btn-danger js-delete" data-order-id="${data}">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        `,
                        orderable: false
                    }
                ]
            });

            document.querySelector('#orders').addEventListener('click', event => {
                if (event.target.closest('.js-delete')) {
                    const button = event.target.closest('.js-delete');
                    const orderId = button.getAttribute('data-order-id');
                    
                    bootbox.confirm({
                        title: "Delete Order",
                        message: "Are you sure you want to delete this order?",
                        buttons: {
                            cancel: {
                                label: '<i class="bi bi-x"></i> Cancel',
                                className: 'btn-secondary'
                            },
                            confirm: {
                                label: '<i class="bi bi-trash"></i> Delete',
                                className: 'btn-danger'
                            }
                        },
                        callback: result => {
                            if (result) {
                                fetch(`/api/NewOrders/${orderId}`, {
                                    method: 'DELETE'
                                })
                                .then(response => {
                                    if (response.ok) {
                                        const row = button.closest('tr');
                                        ordersTable.row(row).remove().draw();
                                        toastr.success("Order successfully removed.");
                                    } else {
                                        throw new Error('Network response was not ok');
                                    }
                                })
                                .catch(error => {
                                    toastr.error("An error occurred while deleting the order.");
                                    console.error(error);
                                });
                            }
                        }
                    });
                }
            });
        });
    </script>
}
