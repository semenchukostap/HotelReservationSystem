@model HotelReservationSystem.ViewModels.NewOrderViewModel
@{
    ViewData["Title"] = "New Order";
}

<h3>New Order</h3>

<form id="newOrder">
    <div class="form-group mb-3">
        <label for="customer" class="form-label">Customer</label>
        <div class="tt-container">
            <input id="customer" name="customer" 
                   data-rule-validCustomer="true" 
                   required type="text" 
                   class="form-control typeahead" />
        </div>
    </div>

    <div class="form-group mb-3">
        <label for="hotel" class="form-label">Hotel</label>
        <div class="tt-container">
            <input id="hotel" name="hotel" 
                   data-rule-validHotel="true" 
                   required type="text" 
                   class="form-control typeahead" />
        </div>
    </div>

    <div class="form-group mb-3">
        <label for="startDate" class="form-label">Start Date</label>
        <input id="startDate" name="startDate" 
               required type="date" 
               class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label for="endDate" class="form-label">End Date</label>
        <input id="endDate" name="endDate" 
               required type="date" 
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            const vm = {};

            // CUSTOMERS
            const customers = new Bloodhound({
                datumTokenizer: Bloodhound.tokenizers.obj.whitespace('name'),
                queryTokenizer: Bloodhound.tokenizers.whitespace,
                remote: {
                    url: '/api/Customers?query=%QUERY',
                    wildcard: '%QUERY'
                }
            });

            $('#customer').typeahead({ minLength: 1, highlight: true }, {
                name: 'customers',
                display: 'name',
                source: customers
            }).on("typeahead:select", (e, customer) => {
                vm.customerId = customer.id;
            });

            // HOTELS
            const hotels = new Bloodhound({
                datumTokenizer: Bloodhound.tokenizers.obj.whitespace('name'),
                queryTokenizer: Bloodhound.tokenizers.whitespace,
                remote: {
                    url: '/api/Hotels?query=%QUERY',
                    wildcard: '%QUERY'
                }
            });

            $('#hotel').typeahead({ minLength: 1, highlight: true }, {
                name: 'hotels',
                display: 'name',
                source: hotels
            }).on("typeahead:select", (e, hotel) => {
                vm.hotelId = hotel.id;
            });

            // VALIDATION METHODS
            $.validator.addMethod("validCustomer", function () {
                return vm.customerId && vm.customerId !== 0;
            }, "Please select a valid customer.");

            $.validator.addMethod("validHotel", function () {
                return vm.hotelId && vm.hotelId !== 0;
            }, "Please select a valid hotel.");

            // VALIDATE AND SUBMIT
            const validator = $("#newOrder").validate({
                submitHandler: function () {
                    bootbox.confirm("Are you sure you want to place this order?", function (result) {
                        if (result) {
                            $.ajax({
                                url: "/api/NewOrders",
                                type: "POST",
                                contentType: "application/json",
                                data: JSON.stringify(vm)
                            })
                            .done(function () {
                                toastr.success("Order successfully recorded.");

                                $("#customer").typeahead("val", "");
                                $("#hotel").typeahead("val", "");
                                $("#startDate").val('');
                                $("#endDate").val('');

                                vm = {};
                                validator.resetForm();
                            })
                            .fail(function (xhr) {
                                if (xhr.responseJSON && xhr.responseJSON.errors) {
                                    toastr.error(xhr.responseJSON.errors.join('<br>'));
                                } else {
                                    toastr.error("Something unexpected happened.");
                                }
                            });
                        }
                    });
                    return false;
                }
            });

            // DATES
            $("#startDate").on('change', function () {
                vm.startDate = $(this).val();
            });

            $("#endDate").on('change', function () {
                vm.endDate = $(this).val();
            });
        });
    </script>
}