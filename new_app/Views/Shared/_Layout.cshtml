<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Hotel Reservation System</title>
    <link rel="stylesheet" href="~/css/bootstrap-flatty.css" />
    <link rel="stylesheet" href="~/css/DataTables/dataTables.bootstrap.css" />
    <link rel="stylesheet" href="~/css/typeahead.css" />
    <link rel="stylesheet" href="~/css/toastr.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a asp-controller="Home" asp-action="Index" class="navbar-brand">Book&Go</a>
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Customers" asp-action="Index">Customers</a></li>
                    <li><a asp-controller="Hotels" asp-action="Index">Hotels</a></li>
                    <li><a asp-controller="Orders" asp-action="Index">Orders</a></li>
                    <li><a asp-controller="Home" asp-action="About">About</a></li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Book&Go</p>
        </footer>
    </div>

    <script src="~/js/jquery-1.10.2.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/bootbox.js"></script>
    <script src="~/js/DataTables/jquery.dataTables.js"></script>
    <script src="~/js/DataTables/dataTables.bootstrap.js"></script>
    <script src="~/js/typeahead.bundle.js"></script>
    <script src="~/js/toastr.js"></script>
    
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>