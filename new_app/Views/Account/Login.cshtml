@model HotelReservationSystem.ViewModels.AccountViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
    var returnUrl = ViewData["ReturnUrl"]?.ToString() ?? "/";
}

<h2>@ViewData["Title"]</h2>
<div class="row">
    <div class="col-md-8">
        <section role="region" aria-labelledby="loginHeading">
            <form id="account" method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" asp-antiforgery="true">
                <h4 id="loginHeading">Use a local account to log in.</h4>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" title="Enter your email address" />
                    <label asp-for="Email" class="form-label"></label>
                    <span asp-validation-for="Email" class="text-danger" role="alert"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" title="Enter your password" />
                    <label asp-for="Password" class="form-label"></label>
                    <span asp-validation-for="Password" class="text-danger" role="alert"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="RememberMe" title="Keep me logged in" />
                        <span>Remember me</span>
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="btn btn-primary" title="Click to log in">Log in</button>
                </div>
                <div class="mt-3">
                    <p>
                        <a asp-action="Register" asp-route-returnUrl="@returnUrl" title="Register a new account">Register as a new user</a>
                    </p>
                    @* Enable this once you have account confirmation enabled for password reset functionality
                    <p>
                        <a asp-action="ForgotPassword" title="Reset your password">Forgot your password?</a>
                    </p>
                    *@
                </div>
            </form>
        </section>
    </div>
    <div class="col-md-4">
        <section role="region" aria-labelledby="externalLoginHeading">
            <h4 id="externalLoginHeading">Use another service to log in.</h4>
            <hr />
            @{
                // In future, external logins can be added here
                // The code for handling external logins has been excluded for simplicity
                // but can be re-implemented if needed
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
