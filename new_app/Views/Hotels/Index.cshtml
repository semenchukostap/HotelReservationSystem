@model IEnumerable<HotelReservationSystem.ViewModels.HotelViewModel>

@{
    ViewData["Title"] = "Hotels";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">Hotels</h1>
                <a asp-controller="Hotels" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> New Hotel
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <table id="hotelsTable" class="table table-striped" style="width:100%" role="grid" aria-label="Hotels list">
                        <thead>
                            <tr>
                                <th scope="col" role="columnheader">Name</th>
                                <th scope="col" role="columnheader">Country</th>
                                <th scope="col" role="columnheader">City</th>
                                <th scope="col" role="columnheader">Stars</th>
                                <th scope="col" role="columnheader">Price per Night</th>
                                <th scope="col" role="columnheader">All Inclusive</th>
                                <th scope="col" role="columnheader">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete this hotel? This action cannot be undone.</p>
                <div class="alert alert-warning mt-3 d-none" id="deleteError" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-danger" id="confirmDelete">
                    <i class="bi bi-trash me-2"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- CSRF Token -->
<form id="antiforgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        class HotelManager {
            constructor() {
                this.table = null;
                this.deleteModal = null;
                this.hotelIdToDelete = null;
                this.csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                this.init();
            }

            init() {
                this.initializeTable();
                this.initializeModal();
                this.setupEventListeners();
            }

            initializeTable() {
            initializeTable() {
                this.table = new DataTable('#hotelsTable', {
                    ajax: {
                        url: '/api/hotels',
                        dataSrc: '',
                        error: (xhr, error, thrown) => {
                            toastr.error('Failed to load hotels data');
                            console.error('DataTable error:', error);
                        }
                    },
                columns: [
                    {
                        data: 'name',
                        render: function (data, type, row) {
                            return `<a href="/hotels/edit/${row.id}" class="text-primary fw-bold">${data}</a>`;
                        }
                    },
                    { data: 'country.name' },
                    { data: 'city' },
                    {
                        data: 'stars',
                        render: function (data) {
                            return '⭐'.repeat(data);
                        }
                    },
                    {
                        data: 'pricePerNight',
                        render: function (data) {
                            return new Intl.NumberFormat('en-US', {
                                style: 'currency',
                                currency: 'USD'
                            }).format(data);
                        }
                    },
                    {
                        data: 'isAllInclusive',
                        render: function (data) {
                            return data
                                ? '<span class="badge bg-success">Yes</span>'
                                : '<span class="badge bg-secondary">No</span>';
                        }
                    },
                    {
                        data: 'id',
                        render: function (data) {
                            return `
                                <div class="btn-group" role="group">
                                    <a href="/hotels/edit/${data}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger js-delete" data-hotel-id="${data}">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>`;
                        }
                    }
                ],
                order: [[0, 'asc']],
                responsive: true,
                language: {
                    search: "Search hotels:",
                    emptyTable: "No hotels available"
                }
            });

            // Initialize Delete Modal
            deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

            setupEventListeners() {
                document.querySelector('#hotelsTable').addEventListener('click', (e) => {
                    const deleteButton = e.target.closest('.js-delete');
                    if (deleteButton) {
                        this.hotelIdToDelete = deleteButton.dataset.hotelId;
                        this.deleteModal.show();
                    }
                });

                document.getElementById('confirmDelete').addEventListener('click', async () => {
                    if (!this.hotelIdToDelete) return;

                    const errorAlert = document.getElementById('deleteError');
                    errorAlert.classList.add('d-none');

                    try {
                        const response = await fetch(`/api/hotels/${this.hotelIdToDelete}`, {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN': this.csrfToken
                            }
                        });

                        if (response.ok) {
                            this.table.ajax.reload();
                            toastr.success('Hotel successfully deleted');
                        } else {
                            const error = await response.json();
                            throw new Error(error.message || 'Failed to delete hotel');
                        }
                    } catch (error) {
                        errorAlert.textContent = error.message;
                        errorAlert.classList.remove('d-none');
                        console.error('Delete error:', error);
                    } finally {
                        this.deleteModal.hide();
                        this.hotelIdToDelete = null;
                    }
                });
            }
        }

        // Initialize the hotel manager when the DOM is ready
        document.addEventListener('DOMContentLoaded', () => {
            const hotelManager = new HotelManager();
        });
    </script>
}
