@model IEnumerable<HotelReservationSystem.ViewModels.HotelViewModel>

@{
    ViewData["Title"] = "Hotels";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0">Hotels</h1>
                <a asp-controller="Hotels" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> New Hotel
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <table id="hotelsTable" class="table table-striped" style="width:100%">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Country</th>
                                <th>City</th>
                                <th>Stars</th>
                                <th>Price per Night</th>
                                <th>All Inclusive</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this hotel?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let hotelTable;
        let deleteModal;
        let hotelIdToDelete;

        document.addEventListener('DOMContentLoaded', function () {
            // Initialize DataTable
            hotelTable = new DataTable('#hotelsTable', {
                ajax: {
                    url: '/api/hotels',
                    dataSrc: ''
                },
                columns: [
                    {
                        data: 'name',
                        render: function (data, type, row) {
                            return `<a href="/hotels/edit/${row.id}" class="text-primary fw-bold">${data}</a>`;
                        }
                    },
                    { data: 'country.name' },
                    { data: 'city' },
                    {
                        data: 'stars',
                        render: function (data) {
                            return '⭐'.repeat(data);
                        }
                    },
                    {
                        data: 'pricePerNight',
                        render: function (data) {
                            return new Intl.NumberFormat('en-US', {
                                style: 'currency',
                                currency: 'USD'
                            }).format(data);
                        }
                    },
                    {
                        data: 'isAllInclusive',
                        render: function (data) {
                            return data
                                ? '<span class="badge bg-success">Yes</span>'
                                : '<span class="badge bg-secondary">No</span>';
                        }
                    },
                    {
                        data: 'id',
                        render: function (data) {
                            return `
                                <div class="btn-group" role="group">
                                    <a href="/hotels/edit/${data}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger js-delete" data-hotel-id="${data}">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>`;
                        }
                    }
                ],
                order: [[0, 'asc']],
                responsive: true,
                language: {
                    search: "Search hotels:",
                    emptyTable: "No hotels available"
                }
            });

            // Initialize Delete Modal
            deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

            // Handle Delete Button Click
            document.querySelector('#hotelsTable').addEventListener('click', function (e) {
                const deleteButton = e.target.closest('.js-delete');
                if (deleteButton) {
                    hotelIdToDelete = deleteButton.dataset.hotelId;
                    deleteModal.show();
                }
            });

            // Handle Delete Confirmation
            document.getElementById('confirmDelete').addEventListener('click', async function () {
                if (!hotelIdToDelete) return;

                try {
                    const response = await fetch(`/api/hotels/${hotelIdToDelete}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        hotelTable.ajax.reload();
                        toastr.success('Hotel successfully deleted');
                    } else {
                        throw new Error('Failed to delete hotel');
                    }
                } catch (error) {
                    toastr.error('An error occurred while deleting the hotel');
                    console.error('Delete error:', error);
                } finally {
                    deleteModal.hide();
                    hotelIdToDelete = null;
                }
            });
        });
    </script>
}