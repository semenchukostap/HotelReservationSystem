@model HotelViewModel
@{
    ViewData["Title"] = Model.Hotel.Id == 0 ? "New Hotel" : "Edit Hotel";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Save" method="post">
    <div class="form-group">
        <label asp-for="Hotel.Name"></label>
        <input asp-for="Hotel.Name" class="form-control" />
        <span asp-validation-for="Hotel.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Hotel.CountryId">Country</label>
        <div class="input-group">
            <select asp-for="Hotel.CountryId" class="form-control">
                <option value="">Select Country</option>
                @foreach (var country in Model.Countries)
                {
                    <option value="@country.Id">@country.Name</option>
                }
            </select>
            <div class="input-group-btn">
                <a asp-action="NewCountry" class="btn btn-default">Add Country</a>
            </div>
        </div>
        <span asp-validation-for="Hotel.CountryId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Hotel.City"></label>
        <input asp-for="Hotel.City" class="form-control" />
        <span asp-validation-for="Hotel.City" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Hotel.Stars"></label>
        <input asp-for="Hotel.Stars" class="form-control" />
        <span asp-validation-for="Hotel.Stars" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Hotel.PricePerNight"></label>
        <input asp-for="Hotel.PricePerNight" class="form-control" />
        <span asp-validation-for="Hotel.PricePerNight" class="text-danger"></span>
    </div>
    <div class="checkbox">
        <label>
            <input asp-for="Hotel.IsAllInclusive" /> All Inclusive
        </label>
    </div>
    
    <input type="hidden" asp-for="Hotel.Id" />
    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}