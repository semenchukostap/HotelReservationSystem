@{
    ViewData["Title"] = "Hotels";
}

<h3 class="page-header">Hotels</h3>

<div>
    <a asp-controller="Hotels" asp-action="Form" class="btn btn-primary">New Hotel</a>
</div>
<br />

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>Price</th>
            <th>AllInclusive</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotels",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name",
                        render: function (data, type, hotel) {
                            return `<a href='/hotels/form/${hotel.id}'>${hotel.name}</a>`;
                        }
                    },
                    {
                        data: "countryName"
                    },
                    {
                        data: "city"
                    },
                    {
                        data: "stars"
                    },
                    {
                        data: "pricePerNight"
                    },
                    {
                        data: "isAllInclusive",
                        render: function (data, type, row) {
                            return data ? "Yes" : "No";
                        }
                    },
                    {
                        data: "id",
                        render: function (data) {
                            return `<button class='btn-link js-delete' data-hotel-id=${data}>Delete</button>`;
                        }
                    }
                ]
            });

            $("#hotels").on('click', '.js-delete', function () {
                const button = $(this);

                bootbox.confirm("Are you sure you want to delete this hotel?", function (result) {
                    if (result) {
                        $.ajax({
                            url: "/api/hotels/" + button.attr("data-hotel-id"),
                            method: "DELETE",
                            success: function () {
                                button.parents("tr").remove();
                                toastr.success("Hotel successfully removed.");
                            }
                        });
                    }
                });
            });
        });
    </script>
}