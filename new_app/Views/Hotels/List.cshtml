@{
    ViewData["Title"] = "Hotels";
}

<h2>Hotels</h2>
<p>
    <a asp-action="New" class="btn btn-primary">New Hotel</a>
</p>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Hotel</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>Price</th>
            <th>All Inclusive</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function () {
            var table = $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotelsapi",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name"
                    },
                    {
                        data: "country"
                    },
                    {
                        data: "city"
                    },
                    {
                        data: "stars"
                    },
                    {
                        data: "pricePerNight",
                        render: function(data){
                            return data + "$";
                        }
                    },
                    {
                        data: "isAllInclusive",
                        render: function (data) {
                            if (data)
                                return "<span class=\"label label-success\">Yes</span>";
                            else
                                return "<span class=\"label label-danger\">No</span>";
                        }
                    },
                    {
                        data: "id",
                        render: function (data) {
                            return "<button class='btn-link js-delete' data-hotel-id=" + data + ">Delete</button> | " +
                                "<a href='/Hotels/Edit/" + data + "'>Edit</a>";
                        }
                    }
                ]
            });

            $("#hotels").on("click", ".js-delete", function () {
                var button = $(this);

                bootbox.confirm("Are you sure you want to delete this hotel?", function (result) {
                    if (result) {
                        $.ajax({
                            url: "/api/hotelsapi/" + button.attr("data-hotel-id"),
                            method: "DELETE",
                            success: function () {
                                table.row(button.parents("tr")).remove().draw();
                            }
                        });
                    }
                });
            });
        });
    </script>
}