@model IEnumerable<Hotel>
@{
    ViewData["Title"] = "Hotels List";
}

<h2>Hotels</h2>

<p>
    <a asp-action="Form" class="btn btn-primary">Add New Hotel</a>
</p>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>Price per night</th>
            <th>All Inclusive</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hotel in Model)
        {
            <tr>
                <td>@hotel.Name</td>
                <td>@hotel.Country?.Name</td>
                <td>@hotel.City</td>
                <td>@hotel.Stars</td>
                <td>@hotel.PricePerNight.ToString("c")</td>
                <td>@(hotel.IsAllInclusive ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Form" asp-route-id="@hotel.Id" class="btn btn-default btn-sm">Edit</a>
                    <button data-hotel-id="@hotel.Id" class="btn btn-danger btn-sm js-delete">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts
{
    <script>
        $(document).ready(function() {
            $("#hotels").DataTable();

            $("#hotels").on("click", ".js-delete", function() {
                var button = $(this);
                bootbox.confirm("Are you sure you want to delete this hotel?", function(result) {
                    if (result) {
                        $.ajax({
                            url: "/api/hotels/" + button.attr("data-hotel-id"),
                            method: "DELETE",
                            success: function() {
                                button.parents("tr").remove();
                                toastr.success("Hotel deleted successfully");
                            },
                            error: function() {
                                toastr.error("Failed to delete the hotel.");
                            }
                        });
                    }
                });
            });
        });
    </script>
}