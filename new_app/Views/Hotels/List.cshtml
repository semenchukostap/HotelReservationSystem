@model IEnumerable<Hotel>
@{
    ViewData["Title"] = "Hotels";
}

<h2>Hotels</h2>
<p>
    <a asp-action="New" class="btn btn-primary">New Hotel</a>
</p>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Hotel</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>Price per night</th>
            <th>All inclusive</th>
            <th>Edit</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function () {
            var table = $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotels",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name",
                    },
                    {
                        data: "countryName",
                    },
                    {
                        data: "city",
                    },
                    {
                        data: "stars",
                    },
                    {
                        data: "pricePerNight",
                    },
                    {
                        data: "isAllInclusive",
                        render: function (data) {
                            if (data === true) return "Yes";
                            else return "No";
                        }
                    },
                    {
                        data: "id",
                        render: function (data) {
                            return "<a href='/hotels/edit/" + data + "' class='btn btn-primary'>Edit</a>";
                        }
                    }
                ]
            });

            $("#hotels").on("click", ".js-delete", function () {
                var button = $(this);
                bootbox.confirm({
                    title: "Delete Hotel",
                    message: "Are you sure you want to delete this hotel? This cannot be undone.",
                    buttons: {
                        cancel: {
                            label: '<i class="fa fa-times"></i> Cancel'
                        },
                        confirm: {
                            label: '<i class="fa fa-check"></i> Confirm'
                        }
                    },
                    callback: function (result) {
                        if (result) {
                            $.ajax({
                                url: "/api/hotels/" + button.attr("data-hotel-id"),
                                method: "DELETE",
                                success: function () {
                                    table.row(button.parents("tr")).remove().draw();
                                    toastr.success("Hotel deleted successfully.");
                                },
                                error: function () {
                                    toastr.error("Something went wrong!");
                                }
                            });
                        }
                    }
                });
            });
        });
    </script>
}