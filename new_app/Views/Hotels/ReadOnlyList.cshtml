@{
    ViewData["Title"] = "Hotels";
}

<h2>Hotels</h2>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Hotel</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>Price</th>
            <th>All Inclusive</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function () {
            $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotelsapi",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name"
                    },
                    {
                        data: "country"
                    },
                    {
                        data: "city"
                    },
                    {
                        data: "stars"
                    },
                    {
                        data: "pricePerNight",
                        render: function(data){
                            return data + "$";
                        }
                    },
                    {
                        data: "isAllInclusive",
                        render: function (data) {
                            if (data)
                                return "<span class=\"label label-success\">Yes</span>";
                            else
                                return "<span class=\"label label-danger\">No</span>";
                        }
                    }
                ]
            });
        });
    </script>
}