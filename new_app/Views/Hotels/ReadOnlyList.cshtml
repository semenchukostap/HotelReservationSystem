@{
    ViewData["Title"] = "Hotels";
}

<h2>Hotels</h2>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Hotel</th>
            <th>Stars</th>
            <th>Country</th>
            <th>City</th>
            <th>Price per night</th>
            <th>All inclusive</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function () {
            var table = $("#hotels").DataTable({
                ajax: {
                    url: "/api/hotels",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name"
                    },
                    {
                        data: "stars"
                    },
                    {
                        data: "country.name"
                    },
                    {
                        data: "city"
                    },
                    {
                        data: "pricePerNight"
                    },
                    {
                        data: "isAllInclusive",
                        render: function(data) {
                            return data ? "Yes" : "No";
                        }
                    }
                ]
            });
        });
    </script>
}