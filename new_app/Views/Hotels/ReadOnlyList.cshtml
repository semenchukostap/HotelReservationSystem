@{
    ViewData["Title"] = "Hotels";
}

<h3 class="page-header">Hotels</h3>

<table id="hotels" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Country</th>
            <th>City</th>
            <th>Stars</th>
            <th>Price</th>
            <th>All Inclusive</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const hotelsTable = new DataTable('#hotels', {
                ajax: {
                    url: "/api/hotels",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name"
                    },
                    {
                        data: "countryName"
                    },
                    {
                        data: "city"
                    },
                    {
                        data: "stars",
                        render: function(data) {
                            return '⭐'.repeat(data);
                        }
                    },
                    {
                        data: "pricePerNight",
                        render: function(data) {
                            return new Intl.NumberFormat('en-US', {
                                style: 'currency',
                                currency: 'USD'
                            }).format(data);
                        }
                    },
                    {
                        data: "isAllInclusive",
                        render: function(data) {
                            return data ? "Yes" : "No";
                        }
                    }
                ],
                responsive: true
            });
        });
    </script>
}