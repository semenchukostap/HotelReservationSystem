@{
    ViewData["Title"] = "Hotel Listings";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 mb-3">Welcome to Our Hotels</h1>
            <p class="lead mb-4">Discover the perfect accommodations for your next trip</p>
            <a class="btn btn-primary" asp-controller="Hotels" asp-action="ReadOnlyList">
                <i class="bi bi-search me-2"></i>Browse All Hotels
            </a>
        </div>
    </div>
</div>
