@{
    ViewData["Title"] = "Book&Go";
}

<div class="p-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h1 class="display-4 fw-bold">Book&Go</h1>
                <p class="fs-4">Simple Hotel Management System</p>
                <hr class="my-4">
                <p>Explore our hotel management features and offerings.</p>
                <a class="btn btn-primary btn-lg" asp-controller="Hotels" asp-action="ReadOnlyList">
                    <i class="bi bi-arrow-right-circle me-2"></i>Learn more
                </a>
            </div>
        </div>
    </div>
</div>
