@{
    ViewData["Title"] = "Home";
}

<div class="jumbotron">
    <h1>Hotel Reservation System</h1>
    <p class="lead">Welcome to the Hotel Reservation System - Book your perfect stay with ease!</p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Hotels</h2>
        <p>Browse our selection of premium hotels around the world.</p>
        <p><a class="btn btn-primary" asp-controller="Hotels" asp-action="ReadOnlyList">View Hotels</a></p>
    </div>
    <div class="col-md-4">
        <h2>Customers</h2>
        <p>Manage customer information and bookings.</p>
        <p><a class="btn btn-primary" asp-controller="Customers" asp-action="Index">View Customers</a></p>
    </div>
    <div class="col-md-4">
        <h2>Orders</h2>
        <p>Track and manage hotel bookings and reservations.</p>
        <p><a class="btn btn-primary" asp-controller="Orders" asp-action="Index">View Orders</a></p>
    </div>
</div>