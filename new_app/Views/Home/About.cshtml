@{
    ViewData["Title"] = "About";
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-8">
        <h3>About Hotel Reservation System</h3>
        <p>
            This application is designed to help manage hotel reservations, customer data, and booking information.
        </p>
        <p>
            Built with ASP.NET Core 8.0, this modern web application provides a robust platform for hotel management.
        </p>

        <h4>Features:</h4>
        <ul>
            <li>Hotel management and listings</li>
            <li>Customer profiles and data tracking</li>
            <li>Reservation booking and management</li>
            <li>Secure user authentication</li>
            <li>Role-based access control</li>
        </ul>
    </div>
    <div class="col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h4 class="card-title">Version</h4>
                <p class="card-text">2.0.0</p>
                <p class="card-text">ASP.NET Core 8.0</p>
                <p class="card-text">© @DateTime.Now.Year - Hotel Reservation System</p>
            </div>
        </div>
    </div>
</div>