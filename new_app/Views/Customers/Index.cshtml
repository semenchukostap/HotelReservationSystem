@model IEnumerable<HotelReservationSystem.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<h3 class="page-header">Customers</h3>

<div>
    <a asp-action="Form" asp-controller="Customers" class="btn btn-primary">New Customer</a>
</div>
<br />

<table id="customers" class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Birthdate</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#customers").DataTable({
                ajax: {
                    url: "/api/customers",
                    dataSrc: ""
                },
                columns: [
                    {
                        data: "name",
                        render: function (data, type, customer) {
                            return `<a href='/customers/form/${customer.id}'>${customer.name}</a>`;
                        }
                    },
                    {
                        data: "birthdate",
                        render: function (data) {
                            if (!data)
                                return "<div>N/A</div>";
                                
                            const date = new Date(data);
                            const formattedDate = date.toLocaleDateString();
                            return `<div>${formattedDate}</div>`;
                        }
                    },
                    {
                        data: "id",
                        render: function (data) {
                            return `<button class='btn btn-link js-delete' data-customer-id=${data}>Delete</button>`;
                        }
                    }
                ]
            });

            $("#customers").on("click", ".js-delete", function () {
                const button = $(this);

                bootbox.confirm("Are you sure you want to delete this customer?", function (result) {
                    if (result) {
                        $.ajax({
                            url: `/api/customers/${button.attr("data-customer-id")}`,
                            method: "DELETE",
                            success: function () {
                                button.parents("tr").remove();
                                toastr.success("Customer successfully removed.");
                            },
                            error: function (xhr) {
                                toastr.error("Something went wrong. Please try again.");
                                console.error(xhr);
                            }
                        });
                    }
                });
            });
        });
    </script>
}