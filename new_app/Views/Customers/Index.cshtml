@model IEnumerable<HotelReservationSystem.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<h3 class="display-4 mb-4">Customers</h3>

<div class="mb-3">
    <a asp-controller="Customers" asp-action="Form" class="btn btn-primary"><i class="bi bi-plus"></i> New Customer</a>
</div>

<div class="table-responsive">
    <table id="customers" class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Birthdate</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            $("#customers").DataTable({
                ajax: {
                    url: "/api/customers",
                    dataSrc: "",
                    error: (xhr, error, thrown) => {
                        toastr.error("Failed to load customer data");
                        console.error(error, thrown);
                    }
                },
                columns: [
                    {
                        data: "name",
                        render: (data, type, customer) => {
                            return `<a href='/customers/form/${customer.id}'>${customer.name || 'Unknown'}</a>`;
                        }
                    },
                    {
                        data: "birthdate",
                        render: (data) => {
                            if (!data)
                                return "<div>N/A</div>";
                                
                            const date = new Date(data);
                            const formattedDate = date.toLocaleDateString();
                            return `<div>${formattedDate}</div>`;
                        }
                    },
                    {
                        data: "id",
                        render: (data) => {
                            return `<button class='btn btn-danger btn-sm js-delete' aria-label="Delete customer" data-customer-id="${data}">Delete</button>`;
                        }
                    }
                ]
            });

            $("#customers").on("click", ".js-delete", function() {
                const button = $(this);
                const customerId = button.attr("data-customer-id");

                bootbox.confirm({
                    message: "Are you sure you want to delete this customer?",
                    buttons: {
                        confirm: {
                            label: 'Yes',
                            className: 'btn-danger'
                        },
                        cancel: {
                            label: 'No',
                            className: 'btn-secondary'
                        }
                    },
                    callback: (result) => {
                        if (result) {
                            $.ajax({
                                url: `/api/customers/${customerId}`,
                                method: "DELETE",
                                success: () => {
                                    const row = $("#customers").DataTable().row(button.closest("tr"));
                                    row.remove().draw();
                                    toastr.success("Customer successfully removed.");
                                },
                                error: (xhr) => {
                                    const errorMessage = xhr.responseJSON?.message || "Something went wrong. Please try again.";
                                    toastr.error(errorMessage);
                                    console.error(xhr);
                                }
                            });
                        }
                    }
                });
            });
        });
    </script>
}