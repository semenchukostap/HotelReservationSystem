@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customers";
}

<h2>Customers</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">New Customer</a>
</p>

<table class="table table-bordered table-hover" id="customers">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Birthdate</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
        <tr>
            <td>@customer.Name</td>
            <td>@(customer.Birthdate.HasValue ? customer.Birthdate.Value.ToString("MMM dd yyyy") : "")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-default btn-sm">Edit</a>
                <button class="btn btn-danger btn-sm js-delete" data-customer-id="@customer.Id">Delete</button>
            </td>
        </tr>
        }
    </tbody>
</table>

@section Scripts
{
    <script>
        $(document).ready(function () {
            var table = $("#customers").DataTable();

            $("#customers").on("click", ".js-delete", function () {
                var button = $(this);
                bootbox.confirm("Are you sure you want to delete this customer?", function (result) {
                    if (result) {
                        $.ajax({
                            url: "/api/customers/" + button.attr("data-customer-id"),
                            method: "DELETE",
                            success: function () {
                                table.row(button.parents("tr")).remove().draw();
                                toastr.success("The customer has been deleted!");
                            },
                            error: function () {
                                toastr.error("Failed to delete customer!");
                            }
                        });
                    }
                });
            });
        });
    </script>
}